# ==============================================================================
# Configuração do Agente de IA para o Nexus WYSIWYG Editor
# Padrão OpenAI (Compatível com OpenAI, Azure, Groq, Ollama, OpenRouter, etc.)
# ==============================================================================

# Chave de API da OpenAI (ou do seu provedor compatível)
VITE_OPENAI_API_KEY=sk-your-openai-key-here

# Base URL da API (padrão oficial OpenAI: https://api.openai.com/v1)
# Exemplos alternativos:
# - Groq: https://api.groq.com/openai/v1
# - Ollama local: http://localhost:11434/v1
# - OpenRouter: https://openrouter.ai/api/v1
# - LM Studio: http://localhost:1234/v1
VITE_OPENAI_BASE_URL=https://api.openai.com/v1

# Modelo padrão (ex: gpt-4o-mini, gpt-4o, llama-3.3-70b-versatile, etc.)
VITE_OPENAI_MODEL=gpt-4o-mini

